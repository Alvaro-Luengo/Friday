# Plantilla de Configuración de Friday / Jarvis
ASSISTANT_NAME=Friday
GOOGLE_API_KEY=tu_google_api_key_aqui
HUGGINGFACE_TOKEN=tu_huggingface_token_aqui
GEMINI_MODEL=gemini-2.5-flash-lite
FRIDAY_LANGUAGE=es
MOM_PHONE=+34600000000
AGY_PATH=C:\Users\alvar\AppData\Local\agy\bin\agy.exe

# Servidor Móvil Web
MOBILE_SERVER_HOST=0.0.0.0
MOBILE_SERVER_PORT=5000
ENABLE_REMOTE_TUNNEL=true
FRIDAY_PIN=1234

# =====================================================================
# CONFIGURACIÓN DE LINK FIJO PERMANENTE (FUERA DE CASA 4G/5G)
# =====================================================================
# Proveedor: 'auto', 'cloudflare', 'ngrok', 'custom'
TUNNEL_PROVIDER=auto

# OPCIÓN A: Cloudflare Zero Trust (Requiere cuenta Cloudflare y dominio propio)
# 1. Crea túnel en dash.teams.cloudflare.com -> Networks -> Tunnels
# 2. Pega tu Token aquí y define tu URL fija:
CLOUDFLARE_TUNNEL_TOKEN=
# FIXED_REMOTE_URL=https://jarvis.midominio.com

# OPCIÓN B (100% GRATIS SIN DOMINIO): Ngrok con Dominio Estático Gratuito
# 1. Regístrate gratis en dashboard.ngrok.com
# 2. En 'Domains', reclama tu dominio estático gratis (ej: mi-jarvis.ngrok-free.app)
# 3. En 'Your Authtoken', copia tu token y pégalos aquí:
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# OPCIÓN C: DDNS Propio (DuckDNS / No-IP con Port Forwarding en tu router)
# FIXED_REMOTE_URL=https://mi-jarvis.duckdns.org:5000

# Motor de Voz
VOICE_ENGINE=edge-tts
NEURAL_VOICE=es-ES-ElviraNeural
VOICE_RATE=+15%
PREFERRED_MICROPHONE=fifine

# Integración Opcional Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
